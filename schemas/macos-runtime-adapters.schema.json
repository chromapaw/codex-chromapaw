{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chromapaw/codex-chromapaw/schemas/macos-runtime-adapters.schema.json",
  "title": "ChromaPaw macOS compatibility adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "mode", "activationImplemented", "adapters"],
  "properties": {
    "schemaVersion": {"const": 1},
    "platform": {"const": "darwin"},
    "mode": {"const": "compatibility-probe"},
    "activationImplemented": {"const": false},
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "appVersion",
          "bundleIdentifier",
          "executableName",
          "activationEnabled",
          "testedTarget"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "appVersion": {"type": "string", "minLength": 1, "maxLength": 80},
          "bundleIdentifier": {"type": "string", "minLength": 1, "maxLength": 200},
          "executableName": {"type": "string", "minLength": 1, "maxLength": 120},
          "activationEnabled": {"const": false},
          "testedTarget": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    }
  }
}
