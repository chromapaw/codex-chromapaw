{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chromapaw/codex-chromapaw/schemas/skin.schema.json",
  "title": "ChromaPaw skin package",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "mode": {
      "enum": ["light", "dark", "adaptive"]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "ink", "accent", "panelOpacity"],
      "properties": {
        "surface": {"$ref": "#/$defs/color"},
        "ink": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "panelOpacity": {"type": "number", "minimum": 0.35, "maximum": 1.0}
      }
    },
    "sourceV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {"type": "string", "minLength": 1, "maxLength": 100},
        "license": {"type": "string", "minLength": 1, "maxLength": 80},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "sourceV2": {
      "allOf": [
        {"$ref": "#/$defs/sourceV1"},
        {"required": ["author", "license"]}
      ]
    },
    "semanticProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "referenceSha256",
        "sourceKind",
        "themeName",
        "visualStyle",
        "mood",
        "identityCues",
        "motifs",
        "avoidElements",
        "depthPlan",
        "safeZoneGuidance"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "referenceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "sourceKind": {"enum": ["full-environment", "subject", "texture", "abstract", "logo"]},
        "themeName": {"type": "string", "minLength": 1, "maxLength": 80},
        "visualStyle": {"type": "string", "minLength": 1, "maxLength": 120},
        "mood": {"type": "string", "minLength": 1, "maxLength": 120},
        "identityCues": {"$ref": "#/$defs/cueList"},
        "motifs": {"$ref": "#/$defs/cueList"},
        "avoidElements": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "depthPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["atmosphere", "distant", "midground", "foreground"],
          "properties": {
            "atmosphere": {"type": "string", "minLength": 1, "maxLength": 240},
            "distant": {"type": "string", "minLength": 1, "maxLength": 240},
            "midground": {"type": "string", "minLength": 1, "maxLength": 240},
            "foreground": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        },
        "safeZoneGuidance": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "cueList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    }
  },
  "oneOf": [
    {
      "title": "Legacy skin package v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "displayName", "mode", "assets", "theme"],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {"$ref": "#/$defs/id"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "mode": {"$ref": "#/$defs/mode"},
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "stylesheet", "preview"],
          "properties": {
            "background": {"type": "string", "pattern": "^[^/\\\\].+\\.(png|webp|jpg|jpeg)$"},
            "stylesheet": {"type": "string", "pattern": "^[^/\\\\].+\\.css$"},
            "preview": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"}
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "ink", "accent"],
          "properties": {
            "surface": {"$ref": "#/$defs/color"},
            "ink": {"$ref": "#/$defs/color"},
            "accent": {"$ref": "#/$defs/color"},
            "panelOpacity": {"type": "number", "minimum": 0.35, "maximum": 1.0}
          }
        },
        "source": {"$ref": "#/$defs/sourceV1"}
      }
    },
    {
      "title": "Skin Studio package v2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "displayName",
        "description",
        "mode",
        "assets",
        "theme",
        "layout",
        "variants",
        "source",
        "qa"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "id": {"$ref": "#/$defs/id"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "mode": {"$ref": "#/$defs/mode"},
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "stylesheet", "preview", "stylesheets", "previews"],
          "properties": {
            "background": {"type": "string", "pattern": "^[^/\\\\].+\\.(png|webp|jpg|jpeg)$"},
            "stylesheet": {"type": "string", "pattern": "^[^/\\\\].+\\.css$"},
            "preview": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"},
            "stylesheets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["light", "dark", "adaptive"],
              "properties": {
                "light": {"type": "string", "pattern": "^[^/\\\\].+\\.css$"},
                "dark": {"type": "string", "pattern": "^[^/\\\\].+\\.css$"},
                "adaptive": {"type": "string", "pattern": "^[^/\\\\].+\\.css$"}
              }
            },
            "previews": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "light-16x10",
                "light-16x9",
                "light-4x3",
                "dark-16x10",
                "dark-16x9",
                "dark-4x3"
              ],
              "properties": {
                "light-16x10": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"},
                "light-16x9": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"},
                "light-4x3": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"},
                "dark-16x10": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"},
                "dark-16x9": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"},
                "dark-4x3": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"}
              }
            }
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "ink", "accent", "panelOpacity", "palettes"],
          "properties": {
            "surface": {"$ref": "#/$defs/color"},
            "ink": {"$ref": "#/$defs/color"},
            "accent": {"$ref": "#/$defs/color"},
            "panelOpacity": {"type": "number", "minimum": 0.35, "maximum": 1.0},
            "palettes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["light", "dark"],
              "properties": {
                "light": {"$ref": "#/$defs/palette"},
                "dark": {"$ref": "#/$defs/palette"}
              }
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["safeContentZone", "depthLayers"],
          "properties": {
            "safeContentZone": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": {"type": "number", "minimum": 0, "maximum": 1},
                "y": {"type": "number", "minimum": 0, "maximum": 1},
                "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            },
            "depthLayers": {
              "const": ["atmosphere", "distant", "midground", "foreground"]
            },
            "visualTreatment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sceneFidelity",
                "contentProtection",
                "subjectPlacement",
                "artworkRecomposed",
                "globalWashOpacity"
              ],
              "properties": {
                "sceneFidelity": {"const": "preserve"},
                "contentProtection": {"const": "local-surfaces"},
                "subjectPlacement": {
                  "enum": ["source", "left", "right", "edge-balanced"]
                },
                "subjectDisplayPriority": {
                  "enum": ["ambient", "supporting", "showcase"]
                },
                "contentLayout": {
                  "enum": ["default", "reserve-subject"]
                },
                "artworkRecomposed": {"type": "boolean"},
                "globalWashOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.12
                }
              }
            }
          }
        },
        "variants": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mode", "aspectRatio", "preview", "stylesheet"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "mode": {"enum": ["light", "dark"]},
              "aspectRatio": {"enum": ["16:10", "16:9", "4:3"]},
              "preview": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"},
              "stylesheet": {"type": "string", "pattern": "^[^/\\\\].+\\.css$"}
            }
          }
        },
        "source": {"$ref": "#/$defs/sourceV2"},
        "semanticProfile": {"$ref": "#/$defs/semanticProfile"},
        "qa": {"type": "string", "pattern": "^[^/\\\\].+\\.json$"}
      }
    }
  ]
}
