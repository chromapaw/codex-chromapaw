{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chromapaw/codex-chromapaw/schemas/skin.schema.json",
  "title": "ChromaPaw skin package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "mode",
    "assets",
    "theme"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 240
    },
    "mode": {
      "enum": ["light", "dark", "adaptive"]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "stylesheet", "preview"],
      "properties": {
        "background": {"type": "string", "pattern": "^[^/\\\\].+\\.(png|webp|jpg|jpeg)$"},
        "stylesheet": {"type": "string", "pattern": "^[^/\\\\].+\\.css$"},
        "preview": {"type": "string", "pattern": "^[^/\\\\].+\\.png$"}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "ink", "accent"],
      "properties": {
        "surface": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "ink": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "panelOpacity": {"type": "number", "minimum": 0.35, "maximum": 1.0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {"type": "string", "maxLength": 100},
        "license": {"type": "string", "maxLength": 80},
        "url": {"type": "string", "format": "uri"}
      }
    }
  }
}
