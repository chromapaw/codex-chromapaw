{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chromapaw/codex-chromapaw/schemas/windows-runtime-adapters.schema.json",
  "title": "ChromaPaw Windows runtime adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transport", "adapters"],
  "properties": {
    "schemaVersion": {"const": 2},
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "host", "port", "backgroundMonitor"],
      "properties": {
        "kind": {"const": "electron-cdp-loopback"},
        "host": {"const": "127.0.0.1"},
        "port": {"const": "ephemeral"},
        "backgroundMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "intervalSeconds"],
          "properties": {
            "enabled": {"const": true},
            "intervalSeconds": {"const": 1.0}
          }
        }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "appVersion",
          "executableName",
          "activationEnabled",
          "executableIdentity",
          "allowedTargetSchemes",
          "browserProductPrefixes",
          "testedTarget"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "appVersion": {"type": "string", "pattern": "^\\d+(?:\\.\\d+){3}$"},
          "executableName": {"type": "string", "pattern": "\\.[Ee][Xx][Ee]$"},
          "activationEnabled": {"type": "boolean"},
          "executableIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "productName",
              "companyName",
              "fileDescription",
              "originalFilename",
              "internalName",
              "signature"
            ],
            "properties": {
              "productName": {"type": "string", "minLength": 1},
              "companyName": {"type": "string", "minLength": 1},
              "fileDescription": {"type": "string", "minLength": 1},
              "originalFilename": {"type": "string", "minLength": 1},
              "internalName": {"type": "string", "minLength": 1},
              "fileVersion": {"type": "string", "minLength": 1},
              "allowedSha256": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
              },
              "signature": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allowedStatuses"],
                "properties": {
                  "allowedStatuses": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "signerSubjectContains": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "allowedTargetSchemes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "browserProductPrefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "testedTarget": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
